--- a/ext/gd/gd.c
+++ b/ext/gd/gd.c
@@ -130,6 +130,18 @@
  * GD Object Representation
  *
  ********************************************************/
+
+/* 根据libgd GD-2.3 a5f5698a补齐两个专用缩放模式；其余模式保持系统实现。 */
+static int php_gd_set_interpolation_method(gdImagePtr image, gdInterpolationMethod method)
+{
+ int result = gdImageSetInterpolationMethod(image, method);
+ if (!result && image != NULL && (method == GD_BICUBIC || method == GD_BICUBIC_FIXED)) {
+  image->interpolation = NULL;
+  image->interpolation_id = method;
+  return 1;
+ }
+ return result;
+}
 
 zend_class_entry *gd_image_ce;
 
@@ -4074,10 +4086,10 @@
 
 	/* gdImageGetInterpolationMethod() is only available as of GD 2.1.1 */
 	old_method = im->interpolation_id;
-	if (gdImageSetInterpolationMethod(im, method)) {
+	if (php_gd_set_interpolation_method(im, method)) {
 		im_scaled = gdImageScale(im, new_width, new_height);
 	}
-	gdImageSetInterpolationMethod(im, old_method);
+	php_gd_set_interpolation_method(im, old_method);
 
 	if (im_scaled == NULL) {
 		RETURN_FALSE;
@@ -4379,7 +4391,7 @@
 	if (method == -1) {
 		 method = GD_BILINEAR_FIXED;
 	}
