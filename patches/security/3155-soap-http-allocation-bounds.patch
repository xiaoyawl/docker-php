From: LookBack <admin@dstw.com>
Subject: [PATCH] PHP7.0 SOAP HTTP allocation arithmetic (GHSA-cj93-vc83-wgqv)

Reference: signed Surý php7.4 7.4.33-31 fixes, ported to PHP7.0 APIs.

--- a/ext/soap/php_http.c
+++ b/ext/soap/php_http.c
@@ -1122,7 +1122,7 @@
 							char *t = phpurl->path;
 							char *p = strrchr(t, '/');
 							if (p) {
-								char *s = emalloc((p - t) + strlen(new_url->path) + 2);
+								char *s = safe_emalloc(1, p - t, strlen(new_url->path) + 2);
 								strncpy(s, t, (p - t) + 1);
 								s[(p - t) + 1] = 0;
 								strcat(s, new_url->path);
@@ -1385,7 +1385,8 @@
 {
 	zend_string *http_buf = NULL;
 	char *header;
-	int header_close = close, header_chunked = 0, header_length = 0, http_buf_size = 0;
+	int header_close = close, header_chunked = 0, header_length = 0;
+	size_t http_buf_size = 0;
 
 	if (!close) {
 		header = get_http_header_value(headers, "Connection: ");
@@ -1415,14 +1416,14 @@
 		done = FALSE;
 
 		while (!done) {
-			int buf_size = 0;
+			unsigned int buf_size = 0;
 
 			php_stream_gets(stream, headerbuf, sizeof(headerbuf));
 			if (sscanf(headerbuf, "%x", &buf_size) > 0 ) {
 				if (buf_size > 0) {
-					int len_size = 0;
-
-					if (http_buf_size + buf_size + 1 < 0) {
+					size_t len_size = 0;
+
+					if (buf_size >= ZSTR_MAX_LEN - http_buf_size) {
 						if (http_buf) {
 							zend_string_release(http_buf);
 						}
@@ -1430,7 +1431,7 @@
 					}
 
 					if (http_buf) {
-						http_buf = zend_string_realloc(http_buf, http_buf_size + buf_size, 0);
+						http_buf = zend_string_safe_realloc(http_buf, 1, http_buf_size, buf_size, 0);
 					} else {
 						http_buf = zend_string_alloc(buf_size, 0);
 					}
@@ -1504,6 +1505,10 @@
 		do {
 			int len_read;
 			if (http_buf) {
+				if (UNEXPECTED(http_buf_size >= ZSTR_MAX_LEN - 4096)) {
+					zend_string_release(http_buf);
+					return NULL;
+				}
 				http_buf = zend_string_realloc(http_buf, http_buf_size + 4096, 0);
 			} else {
 				http_buf = zend_string_alloc(4096, 0);
