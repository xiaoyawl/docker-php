 /* Resolve path relatively to state and put the real path into state */
 /* returns 0 for ok, 1 for error */
+#ifdef ZEND_WIN32
+/* PHP5 has no win32/ioutil layer. Use the same native device-name classifier
+ * as the upstream fix, at the existing virtual-path boundary instead. */
+static int virtual_reserved_device_path(const char *path, size_t len)
+{
+    typedef ULONG (WINAPI *device_name_fn)(PCWSTR);
+    device_name_fn is_device = (device_name_fn)GetProcAddress(GetModuleHandleA("ntdll.dll"), "RtlIsDosDeviceName_U");
+    wchar_t *wide;
+    int wide_len, i, start, skip = 0;
+    if (!len) return 0;
+    /* Preserve bare device names and explicit Win32 device namespaces. */
+    if (!strchr(path, '\\') && !strchr(path, '/') &&
+        (len == 3 || (len == 4 && path[len-1] == ':')) &&
+        (!_strnicmp(path,"NUL",3) || !_strnicmp(path,"CON",3) || !_strnicmp(path,"PRN",3) || !_strnicmp(path,"AUX",3))) return 0;
+    if (len >= 4 && path[3] == '\\' &&
+        ((path[0] == '\\' && path[1] == '\\' && (path[2] == '.' || path[2] == '?')) ||
+         (path[0] == '\\' && path[1] == '?' && path[2] == '?'))) return 0;
+    wide_len = MultiByteToWideChar(CP_ACP, 0, path, (int)len, NULL, 0);
+    if (wide_len <= 0) return 1;
+    wide = emalloc(((size_t)wide_len + 1) * sizeof(wchar_t));
+    MultiByteToWideChar(CP_ACP, 0, path, (int)len, wide, wide_len);
+    wide[wide_len] = 0;
+    i = 0;
+    if (wide_len >= 2 && (wide[0] == L'\\' || wide[0] == L'/') && (wide[1] == L'\\' || wide[1] == L'/')) skip = 2;
+    else if (wide_len >= 2 && wide[1] == L':') i = 2;
+    while (i < wide_len) {
+        wchar_t save;
+        while (i < wide_len && (wide[i] == L'\\' || wide[i] == L'/')) i++;
+        start = i;
+        while (i < wide_len && wide[i] != L'\\' && wide[i] != L'/') i++;
+        if (skip) { skip--; continue; }
+        save = wide[i]; wide[i] = 0;
+        if (is_device && is_device(wide + start)) { efree(wide); return 1; }
+        if (!is_device && (i-start >= 3) &&
+            (!_wcsnicmp(wide+start,L"NUL",3) || !_wcsnicmp(wide+start,L"CON",3) ||
+             !_wcsnicmp(wide+start,L"PRN",3) || !_wcsnicmp(wide+start,L"AUX",3) ||
+             !_wcsnicmp(wide+start,L"COM",3) || !_wcsnicmp(wide+start,L"LPT",3))) {
+            efree(wide); return 1;
+        }
+        wide[i] = save;
+    }
+    efree(wide);
+    return 0;
+}
+#endif
