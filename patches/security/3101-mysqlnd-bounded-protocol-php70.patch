From: LookBack <admin@dstw.com>
Subject: [PATCH] PHP 7.0: bound mysqlnd packet and row decoding

Reference: PHP upstream GHSA-h35g-vwh6-m678 and GHSA-r6x9-5r99-36j7,
signed php7.4 7.4.33-31 fixes, and independently verified PHP5.6 port.
Keep PHP7 zval ownership and pre-7.1 MYSQLND_NET transport API.
Use app for received bytes; preserve old exported unbounded decoder ABI but
replace every network input call with a status-returning bounded reader.

--- a/ext/mysqlnd/mysqlnd_ps_codec.c
+++ b/ext/mysqlnd/mysqlnd_ps_codec.c
@@ -52,6 +52,21 @@
 #define MYSQLND_PS_SKIP_RESULT_W_LEN	-1
 #define MYSQLND_PS_SKIP_RESULT_STR		-2
 
+#define MYSQLND_PS_BAIL() do { \
+    php_error_docref(NULL, E_WARNING, "Malformed prepared statement row packet"); \
+    *row = NULL; \
+    return; \
+} while (0)
+#define MYSQLND_PS_REQUIRE(n) do { if ((size_t)(n) > pack_len) MYSQLND_PS_BAIL(); } while (0)
+#define MYSQLND_PS_READ_LENGTH(target) do { \
+    zend_uchar *start = *row; \
+    uint64_t value; \
+    if (!mysqlnd_read_field_length_checked(row, start + pack_len, &value) || \
+        value == MYSQLND_NULL_LENGTH || value > pack_len - (size_t)(*row - start) || value > INT_MAX) MYSQLND_PS_BAIL(); \
+    target = (zend_ulong)value; \
+    pack_len -= (size_t)(*row - start); \
+} while (0)
+
 /* {{{ ps_fetch_from_1_to_8_bytes */
 void
 ps_fetch_from_1_to_8_bytes(zval * zv, const MYSQLND_FIELD * const field, unsigned int pack_len,
@@ -60,6 +75,7 @@
 	char tmp[22];
 	size_t tmp_len = 0;
 	zend_bool is_bit = field->type == MYSQL_TYPE_BIT;
+	MYSQLND_PS_REQUIRE(byte_count);
 	DBG_ENTER("ps_fetch_from_1_to_8_bytes");
 	DBG_INF_FMT("zv=%p byte_count=%u", zv, byte_count);
 	if (field->flags & UNSIGNED_FLAG) {
@@ -178,6 +194,7 @@
 	float fval;
 	double dval;
 	DBG_ENTER("ps_fetch_float");
+	MYSQLND_PS_REQUIRE(4);
 	float4get(fval, *row);
 	(*row)+= 4;
 	DBG_INF_FMT("value=%f", fval);
@@ -200,6 +217,7 @@
 {
 	double value;
 	DBG_ENTER("ps_fetch_double");
+	MYSQLND_PS_REQUIRE(8);
 	float8get(value, *row);
 	ZVAL_DOUBLE(zv, value);
 	(*row)+= 8;
@@ -218,7 +236,9 @@
 	char * value;
 	DBG_ENTER("ps_fetch_time");
 
-	if ((length = php_mysqlnd_net_field_length(row))) {
+	MYSQLND_PS_READ_LENGTH(length);
+	if (length != 0 && length != 8 && length != 12) MYSQLND_PS_BAIL();
+	if (length) {
 		zend_uchar * to= *row;
 
 		t.time_type = MYSQLND_TIMESTAMP_TIME;
@@ -261,7 +281,9 @@
 	char * value;
 	DBG_ENTER("ps_fetch_date");
 
-	if ((length = php_mysqlnd_net_field_length(row))) {
+	MYSQLND_PS_READ_LENGTH(length);
+	if (length != 0 && length != 4) MYSQLND_PS_BAIL();
+	if (length) {
 		zend_uchar *to= *row;
 
 		t.time_type= MYSQLND_TIMESTAMP_DATE;
@@ -298,7 +320,9 @@
