+static zend_bool check_has_header(const char *headers, const char *header) {
+	const char *s = headers;
+	while ((s = strstr(s, header))) {
+		if (s == headers || (s >= headers + 2 && *(s-1) == '\n' && *(s-2) == '\r')) {
+			return 1;
+		}
+		s++;
+	}
+	return 0;
+}
