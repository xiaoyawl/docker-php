From: LookBack <admin@dstw.com>
Subject: [PATCH] PHP7.0 PHAR TAR size and entry validation (GHSA-j3wh-g957-2m85)

Reference: signed Surý php7.4 7.4.33-31 fixes, ported to PHP7.0 APIs.

--- a/ext/phar/phar_internal.h
+++ b/ext/phar/phar_internal.h
@@ -122,8 +122,13 @@
 #define TAR_FILE    '0'
 #define TAR_LINK    '1'
 #define TAR_SYMLINK '2'
+#define TAR_CHAR    '3'
+#define TAR_BLOCK   '4'
 #define TAR_DIR     '5'
+#define TAR_FIFO    '6'
 #define TAR_NEW     '8'
+#define TAR_LONGLINK 'K'
+#define TAR_LONGNAME 'L'
 #define TAR_GLOBAL_HDR 'g'
 #define TAR_FILE_HDR   'x'
 
--- a/ext/phar/tar.c
+++ b/ext/phar/tar.c
@@ -36,6 +36,52 @@
 	return num;
 }
 /* }}} */
+
+static zend_bool phar_tar_type_has_data(char typeflag)
+{
+	switch (typeflag) {
+		case TAR_LINK:
+		case TAR_SYMLINK:
+		case TAR_CHAR:
+		case TAR_BLOCK:
+		case TAR_DIR:
+		case TAR_FIFO:
+			return 0;
+		default:
+			return 1;
+	}
+}
+
+static zend_bool phar_tar_size(const char *buf, size_t len, uint32_t *result)
+{
+	uint64_t num = 0;
+	size_t i = 0;
+
+	while (i < len && buf[i] == ' ') {
+		++i;
+	}
+
+	/* GNU base-256 encoding is only used for sizes that do not fit the octal field */
+	if (i < len && (((unsigned char) buf[i]) & 0x80)) {
+		return 0;
+	}
+
+	while (i < len && buf[i] >= '0' && buf[i] <= '7') {
+		num = num * 8 + (buf[i] - '0');
+		++i;
+	}
+
+	while (i < len && (buf[i] == ' ' || buf[i] == '\0')) {
+		++i;
+	}
+
+	if (i != len || num > UINT32_MAX - 511) {
+		return 0;
+	}
+
+	*result = (uint32_t) num;
+	return 1;
+}
 
 /* adapted from format_octal() in libarchive
  *
@@ -263,8 +309,32 @@
 		memset(hdr->checksum, ' ', sizeof(hdr->checksum));
 		sum2 = phar_tar_checksum(buf, old?sizeof(old_tar_header):sizeof(tar_header));
 
-		size = entry.uncompressed_filesize = entry.compressed_filesize =
-			phar_tar_number(hdr->size, sizeof(hdr->size));
+		if (!phar_tar_size(hdr->size, sizeof(hdr->size), &size)) {
+			if (error) {
+				spprintf(error, 4096, "phar error: \"%s\" is a corrupted tar file (invalid entry size)", fname);
+			}
+			if (last_was_longlink) {
+				pefree(entry.filename, myphar->is_persistent);
+			}
+			php_stream_close(fp);
+			phar_destroy_phar_data(myphar);
+			return FAILURE;
+		}
+		entry.uncompressed_filesize = entry.compressed_filesize = size;
+
+		/* GNU long link names are not supported, so refuse the record instead of
+		 * registering it as an entry and dropping the link target of the entry that follows */
+		if (hdr->typeflag == TAR_LONGLINK) {
+			if (error) {
+				spprintf(error, 4096, "phar error: \"%s\" is a tar file with an unsupported GNU long link entry", fname);
+			}
+			if (last_was_longlink) {
+				pefree(entry.filename, myphar->is_persistent);
+			}
+			php_stream_close(fp);
+			phar_destroy_phar_data(myphar);
+			return FAILURE;
+		}
 
 		/* skip global/file headers (pax) */
 		if (!old && (hdr->typeflag == TAR_GLOBAL_HDR || hdr->typeflag == TAR_FILE_HDR)) {
@@ -350,13 +420,13 @@
 			goto bail;
 		}
 
