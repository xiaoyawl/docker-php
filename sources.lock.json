  "patches": [
    {
      "file": "compat/0044-Add-missing-header-includes.patch",
      "sha256": "43e5c9f23d8e764355d784896ecea02adf02a46746ccf0f299c464e367698994",
      "change": "原样提取自 Surý php8.5 打包（8.5.12-1+0~20261021.27+debian12~1.gbp1a3e8a）；补齐缺失的头文件声明，适配现代编译器"
    },
    {
      "file": "security/9001-mysqlnd-ok-payload-and-length-prefix.patch",
      "sha256": "8a821678f9a7d084786bc6845f181c4b86617bc5100eb8badaee03538e41ed28",
      "change": "本地 mysqlnd 加固：OK 消息按实际包边界校验，两个长度解码器拒绝非法 0xff 前缀（协议回归实测复现）"
    },
    {
      "file": "compat/9002-system-gd-bicubic.patch",
      "sha256": "6e0d7565e0b394c7122ff0a2b73abe14ce95d8a72524a4aa52d3fdf41775f05a",
      "change": "外部 libgd 2.3.3 缺少上游 a5f5698 双三次插值设置修复；仅在 libgd setter 拒绝这两个模式时按官方相同字段语义补齐"
    },
    {
      "file": "security/9003-mysqlnd-preserve-high-length-bits.patch",
      "sha256": "5d3ee0ef36191923b1981c16a95984cab28c8ebf4108a31613dac7c33c1b8516",
      "change": "本地 mysqlnd 加固：0xfe 长度完整读取 64 位；不小于非法长度哨兵的值钳制为哨兵减一，避开 NULL/非法哨兵并由各调用处边界检查拒绝"
    }
  ],
